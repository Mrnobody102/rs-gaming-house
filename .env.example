# Optional override; production also supports setting the password on first visit.
ADMIN_PASSCODE=replace-with-your-own-passcode
# Optional stable signing secret. Changing either secret invalidates admin cookies.
ADMIN_SESSION_SECRET=
ADMIN_SETTINGS_DIR=

# Optional external PostgreSQL. When set, PGlite is not loaded.
# On Render use the Internal Database URL from a database in the same region.
DATABASE_URL=

# Optional public origin for QR links, e.g. https://play.example.com
# On a LAN, use the laptop's reachable IP and port. Players need the same network.
JOIN_BASE_URL=

# Default: local files. To upload to Cloudinary, set cloudinary and all three fields.
MEDIA_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional absolute paths to persistent directories on a single Node server.
APP_DATA_DIR=
MEDIA_DIR=
